@page "/product/{Id:int}"
@using BlazorApp2.Models
@inject BlazorApp2.Services.ProductService ProductService
@inject BlazorApp2.Services.CartService CartService
@inject NavigationManager Nav

@functions {
    [Parameter]
    public int Id { get; set; }

    private Product? product;

    protected override void OnInitialized()
    {
        product = ProductService.GetById(Id);
    }

    void AddToCart()
    {
        if (product is null) return;
        CartService.AddToCart(product, 1);
        Nav.NavigateTo("/cart");
    }
}

@if (product is null)
{
    <p>Product not found.</p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <img src="@product.ImageUrl" class="img-fluid" alt="@product.Name" />
        </div>
        <div class="col-md-6">
            <h2>@product.Name</h2>
            <p>@product.Description</p>
            <h4>@product.Price.ToString("C")</h4>
            <button class="btn btn-success" @onclick="AddToCart">Add to cart</button>
        </div>
    </div>
}
