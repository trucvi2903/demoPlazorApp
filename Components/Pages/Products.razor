@page "/products"
@using BlazorApp2.Models
@inject BlazorApp2.Services.ProductService ProductService
@inject NavigationManager Nav
@inject BlazorApp2.Services.CartService CartService

@functions {
    private int currentPage = 1;
    private int pageSize = 6;
    private IEnumerable<Product> products = Enumerable.Empty<Product>();
    private int totalPages = 1;

    protected override void OnInitialized()
    {
        var all = ProductService.GetAll().ToList();
        totalPages = (int)Math.Ceiling(all.Count / (double)pageSize);
        LoadPage(1);
    }

    void LoadPage(int page)
    {
        currentPage = Math.Clamp(page, 1, totalPages);
        products = ProductService.GetAll().Skip((currentPage - 1) * pageSize).Take(pageSize);
    }

    void Goto(int page)
    {
        LoadPage(page);
        Nav.NavigateTo($"/products?page={page}", forceLoad: false);
    }

    void ViewDetails(int id)
    {
        Nav.NavigateTo($"/product/{id}");
    }

    void AddToCart(Product p)
    {
        if (p is null) return;
        CartService.AddToCart(p, 1);
        StateHasChanged();
    }
}

<h3>Products</h3>

<div class="row">
    @foreach (var p in products)
    {
        <div class="col-12 col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text">@p.Description</p>
                    <div class="mt-auto d-flex align-items-center">
                        <strong>@p.Price.ToString("C")</strong>
                        <button class="btn btn-success btn-sm ms-2" @onclick="(() => AddToCart(p))">Chọn mua</button>
                        <button class="btn btn-primary btn-sm ms-2" @onclick="(() => ViewDetails(p.Id))">Chi tiết</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @(currentPage==1?"disabled":"")">
            <a class="page-link" href="#" @onclick="(()=>Goto(currentPage-1))">Previous</a>
        </li>
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i==currentPage?"active":"")"><a class="page-link" href="#" @onclick="(()=>Goto(i))">@i</a></li>
        }
        <li class="page-item @(currentPage==totalPages?"disabled":"")">
            <a class="page-link" href="#" @onclick="(()=>Goto(currentPage+1))">Next</a>
        </li>
    </ul>
</nav>
